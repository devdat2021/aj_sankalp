DEMO_MODE=true
MONGODB_URI=
MONGODB_DB=coastwatch
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only: sb_secret_... (or a legacy service_role key). Never use a VITE_ prefix.
SUPABASE_SECRET_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Crisis SQL defaults to backend/data/crisis.db; leave unset to use it.
# CRISIS_DATABASE_URL=sqlite:///D:/Aj1/backend/data/crisis.db
LLM_PROVIDER=none

# Operational intelligence uses the existing MongoDB store (Atlas or replica set required).
INTELLIGENCE_ENABLED=false
OPTIMIZATION_ENABLED=false
GOOGLE_CLOUD_PROJECT=
# Optional credential JSON path; leave blank to use gcloud Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Applied only when Google explicitly reports the configured model is retired; empty disables.
GEMINI_RETIRED_MODEL_FALLBACK=gemini-3.7-flash
INTELLIGENCE_TIMEOUT_SECONDS=45
GEMINI_TIMEOUT_SECONDS=90
INTELLIGENCE_CACHE_SECONDS=900
